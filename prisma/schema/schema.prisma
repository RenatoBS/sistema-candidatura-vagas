// Schema Prisma — entrada multi-arquivo (Fase 2).
// Domínios: identidade, vagas, candidatos, entrevistas, notificacoes.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// --- Papéis e status compartilhados ---

enum PapelGlobal {
  ADMIN_PLATAFORMA
}

enum PapelEmpresa {
  ADMIN_EMPRESA
  RECRUTADOR
  AVALIADOR
}

enum StatusMembroEmpresa {
  ATIVO
  CONVIDADO
  REMOVIDO
}

enum StatusVerificacaoEmpresa {
  PENDENTE
  VERIFICADA
  REJEITADA
  SUSPENSA
}

enum TipoVerificacaoEmpresa {
  EMAIL
  DOMINIO
  CNPJ
  REVISAO_MANUAL
}

enum VisaoPreferida {
  CANDIDATO
  EMPRESA
  ADMIN
}
