{
  "name": "@scv/prisma",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "prisma generate --schema=schema",
    "db:migrate": "prisma migrate dev --schema=schema",
    "db:migrate:deploy": "prisma migrate deploy --schema=schema",
    "db:push": "prisma db push --schema=schema",
    "db:seed": "prisma db seed --schema=schema",
    "db:reset": "prisma migrate reset --schema=schema --force",
    "build": "prisma generate --schema=schema",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/**/*.test.ts"
  },
  "prisma": {
    "seed": "tsx seed.ts",
    "schema": "schema"
  },
  "devDependencies": {
    "@scv/config": "workspace:*",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0"
  }
}
