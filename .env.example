# =============================================================================
# Sistema de Candidatura a Vagas — variáveis de ambiente (desenvolvimento)
# Copie para .env e ajuste conforme necessário. NUNCA commite o arquivo .env.
# =============================================================================

# --- API ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Workers ---
WORKERS_PORT=3001
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Banco de dados ---
# Runtime (API/workers): papel scv_app, sem superuser e sem BYPASSRLS — o RLS vale de verdade.
# O papel é criado por infra/postgres/init/01-papel-scv-app.sh (ver docs/runbooks/ambiente-local.md).
SCV_APP_DB_PASSWORD=<defina-uma-senha-local>
DATABASE_URL=postgresql://scv_app:<SCV_APP_DB_PASSWORD>@localhost:5432/scv?schema=public
# Migrações, seed e reset: papel dono do schema (scv). Tem prioridade sobre DATABASE_URL nos scripts db:*.
MIGRATION_DATABASE_URL=postgresql://scv:<POSTGRES_PASSWORD>@localhost:5432/scv?schema=public
POSTGRES_USER=scv
POSTGRES_PASSWORD=<defina-uma-senha-local>
POSTGRES_DB=scv
POSTGRES_PORT=5432

# --- MinIO (S3-compatível) ---
MINIO_ROOT_USER=<defina-um-usuario-local>
MINIO_ROOT_PASSWORD=<defina-uma-senha-local>
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=<mesmo-valor-de-MINIO_ROOT_USER>
S3_SECRET_KEY=<mesmo-valor-de-MINIO_ROOT_PASSWORD>
S3_BUCKET=scv-dev

# --- LiveKit (dev) ---
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT=7882
LIVEKIT_URL=ws://localhost:7880

# --- Mailpit (e-mail dev) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025

# --- OpenTelemetry (opcional) ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# --- Auth (Fase 3) ---
# openssl rand -base64 32
JWT_SECRET=
APP_ENCRYPTION_KEY=
AUTH_STORE=prisma
# sempre | falha | nunca — padrão do código: falha
REVISAO_MANUAL_EMPRESA=falha
INTERNAL_JOB_TOKEN=
# URL pública da API. Fora de dev/test não pode ser localhost; em dev a Uazapi só alcança via túnel
# (docs/runbooks/webhook-uazapi-dev.md).
API_PUBLIC_URL=http://localhost:3000
SMTP_FROM=nao-responda@localhost

# --- Notificações (Fase 6) ---
# mock (padrão) | expo; o token é opcional e nunca é exigido em dev/teste
PUSH_PROVIDER=mock
EXPO_ACCESS_TOKEN=
PUSH_TOKEN_RETENCAO_DIAS=90

# --- App ---
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# --- Uazapi (sem valores; o Renato configura fora do repo) ---
UAZAPI_BASE_URL=
UAZAPI_ADMIN_TOKEN=

# --- Currículo (Fase 5) ---
# Sem CLAMAV_HOST o antivírus fica no mock (ainda recusa a assinatura EICAR).
CLAMAV_HOST=
CLAMAV_PORT=3310
# tesseract no worker real; mock só em teste ou OCR_PROVIDER=mock
OCR_PROVIDER=tesseract
TESSERACT_BIN=tesseract
PDFTOPPM_BIN=pdftoppm
# mock | llm — estruturação do currículo. mock é o padrão em dev/teste.
EXTRATOR_CURRICULO=mock

# --- Simulador de entrevista (somente desenvolvimento) ---
# true liga o chat /dev/simulador-whatsapp, o adaptador de WhatsApp em memória e o entrevistador determinístico.
# A API recusa subir em produção com esta flag. Não chama Uazapi nem OpenAI.
SIMULADOR_ENTREVISTA=
# Com as legendas, o app de demo também usa um processo seletivo mais curto (3+1) para a gravação.
EXPO_PUBLIC_LEGENDAS_DEMO=

# --- LLM (Fase 4; padrão mock, sem rede) ---
# mock | openai | ollama. Com SIMULADOR_ENTREVISTA=true o entrevistador simulado substitui o provedor, inclusive openai.
LLM_PROVIDER=mock
LLM_MODELO=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
STT_PROVIDER=fake
STT_MODELO=whisper-1
STT_LIMIAR_CONFIANCA=0.6
# Obrigatório quando UAZAPI_BASE_URL/UAZAPI_ADMIN_TOKEN estão definidos (a API não sobe sem ele).
UAZAPI_WEBHOOK_SECRET=
OLLAMA_BASE_URL=http://localhost:11434
# --- Embeddings e match (Fase 6) ---
# fake | openai. Vazio: openai se houver EMBEDDING_BASE_URL ou OPENAI_API_KEY; senão fake (determinístico, sem rede)
EMBEDDING_PROVIDER=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODELO=text-embedding-3-small
# Compatibilidade mínima (0–1] para marcar uma sugestão de match como forte
MATCH_LIMIAR_FORTE=0.75
# Dias até alertar pausa longa (não fecha a vaga)
PAUSA_MAX_DIAS=30

# --- STT / Voz (fases futuras) ---
STT_API_KEY=placeholder
