{
  "name": "@scv/workers",
  "version": "0.1.0",
  "private": true,
  "description": "Processos BullMQ (OCR, STT, IA, WhatsApp, prazos, notificações)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.4",
    "@bull-board/express": "^9.10.4",
    "@scv/domain": "workspace:*",
    "@scv/env": "workspace:*",
    "@scv/providers": "workspace:*",
    "bullmq": "^6.3.12",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@scv/config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
