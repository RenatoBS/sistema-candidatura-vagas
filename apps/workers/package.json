{
  "name": "@scv/workers",
  "version": "0.1.0",
  "private": true,
  "description": "Processos BullMQ (OCR, STT, IA, WhatsApp, prazos, notificações)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@bull-board/api": "^6.7.10",
    "@bull-board/express": "^6.7.10",
    "@scv/domain": "workspace:*",
    "@scv/env": "workspace:*",
    "@scv/providers": "workspace:*",
    "bullmq": "^5.44.0",
    "express": "^4.21.2",
    "ioredis": "^5.6.0",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@scv/config": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2"
  }
}
