{
  "name": "@scv/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "App React Native único (Expo Router): candidato, empresa e admin",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/validate-entry.mjs",
    "dev": "expo start",
    "start": "expo start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "clean": "rm -rf dist .expo"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "~15.1.1",
    "@react-navigation/native": "^7.0.14",
    "@scv/contracts": "workspace:*",
    "@scv/domain": "workspace:*",
    "@tanstack/react-query": "^5.69.0",
    "expo": "~58.0.7",
    "expo-constants": "~57.0.21",
    "expo-document-picker": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-router": "~58.0.17",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.4.3",
    "qrcode-generator": "^2.0.4",
    "query-string": "9.5.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.16",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "~4.29.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@scv/config": "workspace:*",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~12.0.9",
    "eslint": "^9.22.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
