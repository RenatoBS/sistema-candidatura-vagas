{
  "name": "@scv/voice-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Agente de voz da 2ª fase (participante das salas LiveKit) — stub",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@scv/config": "workspace:*",
    "eslint": "^9.22.0",
    "pino": "^9.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
