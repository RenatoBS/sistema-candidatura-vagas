# --- Modo de execução ---
# mock | openai | hibrido (STT/TTS OpenAI + LLM Ollama local)
POC_MODO=mock

# --- OpenAI (STT Whisper, LLM, TTS) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_STT_MODEL=whisper-1
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova

# --- Ollama local (LLM) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Fixture de áudio ---
POC_AUDIO_FIXTURE=fixtures/pergunta-candidato.wav

# --- Contexto da entrevista (prompt do agente) ---
POC_SYSTEM_PROMPT=Você é um entrevistador de RH. Responda em português do Brasil, em uma frase curta e natural, como se estivesse conduzindo uma entrevista por voz.
