{
  "name": "@scv/api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST NestJS",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test,test-prisma}/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/**/*.test.ts",
    "test:prisma": "node --import tsx --test --test-concurrency=1 'test-prisma/**/*.test.ts'",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@prisma/client": "^7.10.0",
    "@scv/contracts": "workspace:*",
    "@scv/domain": "workspace:*",
    "@scv/env": "workspace:*",
    "@scv/llm": "workspace:*",
    "@scv/providers": "workspace:*",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.12",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/testing": "^11.0.12",
    "@scv/config": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "tsx": "^4.19.3",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.8.2"
  }
}
